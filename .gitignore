# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# Production
/dist

# Environment variables — NEVER commit these.
# .env.local holds your Supabase keys and ANTHROPIC_API_KEY.
# .env.example is the safe, committed template (no real values).
.env
.env*.local
.env.production

# Supabase local dev
/supabase/.branches
/supabase/.temp

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Agent skills — vendored content, restorable from skills-lock.json.
# Treat these like node_modules: the LOCKFILE is committed (it pins the source and a
# content hash, so an installed skill can't silently change under you), the downloaded
# files are not. Restore with: npx skills install
/.agents/
/.claude/skills/

# macOS — the thing that gave us "gp-guardian 2" in the first place
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
/.vscode
/.idea
*.swp

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
